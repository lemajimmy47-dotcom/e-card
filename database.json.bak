    {
      "id": "761214",
      "senderId": "HARUSI",
      "name": "Harusi ya Joachim & Diana",
      "date": "2026-08-29",
      "time": "18:00",
      "period": "Jioni",
      "eventHallName": "FIMBO SOCIAL HALL",
      "coordinates": "-6.7887707, 39.1711458",
      "hostName": "Shekiel Tarimo",
      "dressCode": "Burgundy & Navy Blue",
      "contact1": "0653578184",
      "contact1Name": "Jimson Lema",
      "contact2": "0761452589",
      "contact2Name": "Humphrey Lema",
      "contact3": "",
      "contact3Name": "",
      "mapsLink": "https://www.google.com/maps/place/FIMBO+SOCIAL+HALL/@-6.7887707,39.1711458,17z/data=!3m1!4b1!4m6!3m5!1s0x185c4f006723be5d:0x7e280395e3803770!8m2!3d-6.788776!4d39.1737207!16s%2Fg%2F11w__wq0jz?entry=ttu&g_ep=EgoyMDI2MDgwNS4xIKXMDSoASAFQAw%3D%3D",
      "eventImgUrl": "",
      "messageLogs": [],
      "smsTemplates": {
        "rem1En": "Dear {Mgeni},\n\nThis is a friendly reminder regarding your contribution pledge for \"{Tukio}\".\n\nYour contribution status:\n- Pledged: TZS {Ahadi}\n- Already Paid: TZS {Paid}\n- Outstanding Balance: TZS {Balance}\n\nPlease complete your contribution by {tarehe_ya_mwisho}.\n\nYou can send your contribution via:\n{payment_methods}\n\nThank you for your generous support and God bless you.",
        "rem1Sw": "Ndugu {Mgeni},\n\nTunakukumbusha  kuhusu ahadi yako ya mchango kwa ajili ya {Tukio}.\n\nTaarifa za mchango:\n\n Ahadi: TZS {Ahadi}\n\n Tayari Umelipa: TZS {Paid}\n\n Salio linalobaki: TZS {Balance}\n\nTafadhali kamilisha mchango wako kabla ya tarehe {tarehe_ya_mwisho}.\n\nUnaweza kutuma kupitia:\n\n{namba_za_malipo}\n\nAhsante sana kwa ushirikiano wako na Mungu akubariki.",
        "rem2En": "Dear {Mgeni},\n\nThis is a respectful reminder to complete your pending outstanding contribution balance to support our event \"{Tukio}\".\n\nBalance Due: TZS {Balance}\n\nThank you sincerely for your generosity.",
        "rem2Sw": "Ndugu {Mgeni},\n\nTunakukumbusha kwa heshima kabisa kukamilisha ahadi yako ya mchango kwa ajili ya kufanikisha tukio la {Tukio}.\n\nSalio linalobaki: TZS {Balance}\n\nAsante sana kwa ukarimu wako.",
        "pledge1En": "Hello {name},\n\nThe family of {host_name} warmly invites you to support our upcoming {event_name} scheduled for {date}.\n\nYour contribution is deeply appreciated and will play a vital role in making this celebration a success. We kindly request you to submit your pledge or contribution by {tarehe_ya_mwisho}.\n\nContribution Details:\n{namba_za_malipo}\n\nThank you for your love and support!",
        "pledge1Sw": "Habari {name},\n\nFamilia ya {host_name} inakusalimu kwa unyenyekevu. Tunakuomba ushirikiane nasi kwa mchango wako wa upendo ili kufanikisha tukio letu la {event_name} litakalofanyika tarehe {date}.\n\nMchango wako ni wa thamani kubwa kwetu na utasaidia sana katika maandalizi ya jambo hili. Tunaomba uwasilishe mchango wako kabla ya tarehe {tarehe_ya_mwisho}.\n\nNamba za Michango:\n{namba_za_malipo}\n\nAhsante sana kwa upendo wako na Mungu akubariki!",
        "pledge2En": "Dear {Mgeni},\n\nWe would be honored by your support in planning our upcoming event \"{Tukio}\".\n\nThank you deeply.",
        "pledge2Sw": "Ndugu {Mgeni},\n\nTunapokea kwa furaha ahadi za michango kwa ajili ya maandalizi ya tukio la {Tukio}.\n\nAsante muno.",
        "thanks1En": "Hello {Mgeni},\n\nWe would like to thank you with immense gratitude for fully completing your contribution pledge for our event \"{Tukio}\".\n\nThank you so much and God bless you!",
        "thanks1Sw": "Habari {{1}},\n\nTunakushukuru kwa upendo mkubwa kwa kukamilisha mchango wako kikamilifu kwa ajili ya kufanikisha tukio letu la {{2}}.\n\nAsante sana na Mungu akubariki!",
        "thanks2En": "Dear {Mgeni},\n\nWe have successfully recorded your contribution in full.\n\nYour presence and priceless support are deeply appreciated as they play a huge role in making \"{Tukio}\" a reality.\n\nBlessings to you!",
        "thanks2Sw": "Habari {{1}},\n\nTunakushukuru kwa upendo mkubwa kwa kukamilisha mchango wako kikamilifu kwa ajili ya kufanikisha tukio letu la {{2}}.\n\nAsante sana na Mungu akubariki!",
        "generalThanksEn": "Hello {name},\nThe family of {host_name} would like to express our deepest gratitude for attending {event_name}.\nYour presence made our event truly special and blessed.\n\nContacts:\n- {contact_1_name}: {contact_1_phone}\n- {contact_2_name}: {contact_2_phone}\n\nThank you very much and God bless you!",
        "generalThanksSw": "Habari {name},\nFamilia ya {host_name} inapenda kutoa shukrani za dhati kwa kuhudhuria {event_name}.\nUshiriki wako umefanya sherehe yetu kuwa ya kipekee na yenye baraka.\n\nAsante sana na Mungu akubariki!",
        "invitationTemplateEn": "Hello {name},\nThe family of {host_name} , are pleased to welcome you to join us for {event_name}.\n\nEVENT DETAILS\nDate: {date}\nVenue: {venue}\nTime: {time}\nCard No: {card_number}\nCard Type: {card_type}\n\n{Link}\n\nContacts:\n- {contact_1_name}: {contact_1_phone}\n- {contact_2_name}: {contact_2_phone}\n\nYou are warmly welcome!",
        "invitationTemplateSw": "Habari {name},\nFamilia ya {host_name} , inayo furaha kubwa kukukaribisha kushiriki katika {event_name}.\n\nTAARIFA ZA SHEREHE\nTarehe: {date}\nUkumbi: {venue}\nMuda: {time}\nKadi Na: {card_number}\nAina ya Kadi: {card_type}\n\n{Link}\n\nMawasiliano:\n- {contact_1_name}: {contact_1_phone}\n- {contact_2_name}: {contact_2_phone}\n\nKaribu sana!"
      },
